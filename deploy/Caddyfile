your-name.duckdns.org {
	encode gzip zstd
	# 학생 IDE: Docker가 고르는 호스트 포트 범위(32768-60999)만 받는다. 다른 로컬 포트로는 프록시하지 않는다.
	@ideBare path_regexp ideBare ^/ide/(3276[89]|327[7-9][0-9]|32[89][0-9][0-9]|3[3-9][0-9]{3}|[45][0-9]{4}|60[0-9]{3})$
	redir @ideBare {path}/ 308
	@ide path_regexp ide ^/ide/(3276[89]|327[7-9][0-9]|32[89][0-9][0-9]|3[3-9][0-9]{3}|[45][0-9]{4}|60[0-9]{3})(/.*)$
	handle @ide {
		# route로 묶어 순서를 고정한다. 기본 지시어 순서로는 uri strip_prefix가 forward_auth보다 먼저 돈다.
		route {
			# 앱에 먼저 묻는다: 이 브라우저(LAB_STUDENT 쿠키)가 이 포트 IDE 주인인가. 204면 통과, 그 밖의 응답(401)은
			# 그대로 브라우저에 돌려주고 IDE로는 보내지 않는다. 웹소켓 업그레이드 요청도 같은 확인을 거친다.
			# 원래 요청의 Cookie 헤더는 forward_auth가 그대로 앱에 넘긴다. 포트는 위 정규식에서 숫자로만 잡힌 값이다.
			forward_auth 127.0.0.1:8080 {
				uri /api/ide-auth/{re.ide.1}
			}
			uri strip_prefix /ide/{re.ide.1}
			reverse_proxy 127.0.0.1:{re.ide.1} {
				# IDE는 강사 화면과 같은 출처라 브라우저가 이 앱의 쿠키(강사 세션 JSESSIONID, CSRF XSRF-TOKEN, 학생 세션
				# LAB_STUDENT)를 학생 컨테이너에도 보낸다. 그 셋을 의미 없는 swunion-stripped=1로 바꾸고 나머지
				# (code-server-session 등)는 그대로 넘긴다. 이 치환은 code-server로 가는 요청에만 걸린다. 앱에 묻는 요청은
				# 원래 Cookie를 그대로 보내야 한다.
				# 첫 줄은 중간·끝 쿠키, 둘째 줄은 맨 앞 쿠키를 맡는다. 바꿀 값을 빈 문자열로 두면 Ubuntu 패키지의
				# Caddy 2.6.2가 치환이 아니라 Cookie 헤더 전체 덮어쓰기로 읽어 code-server 로그인이 풀리므로 비워 두지 않는다.
				header_up Cookie ";\s*(JSESSIONID|XSRF-TOKEN|LAB_STUDENT)=[^;]*" "; swunion-stripped=1"
				header_up Cookie "^(JSESSIONID|XSRF-TOKEN|LAB_STUDENT)=[^;]*" "swunion-stripped=1"
			}
		}
	}
	handle {
		reverse_proxy 127.0.0.1:8080
	}
}
