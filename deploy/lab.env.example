PUBLIC_BASE_URL=https://your-name.duckdns.org
IDE_BIND_ADDRESS=127.0.0.1
INSTRUCTOR_PASSWORD=<강한 비밀번호>
CONTAINER_MEMORY_MB=800
PATH=/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
IDE_URL_TEMPLATE={base}/ide/{port}/
IDE_AUTH=proxy
# Bedrock으로 Claude를 부르려면 아래 세 줄의 주석을 푼다(인스턴스 역할 사용, API 키 불필요).
# LLM_PROVIDER=bedrock
# LLM_MODEL=global.anthropic.claude-haiku-4-5-20251001-v1:0
# BEDROCK_REGION=ap-southeast-1
