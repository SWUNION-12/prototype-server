# 수업 {{COURSE_ID}} 로컬 설치 스크립트. 실행 전에 이 주소에서 내용을 볼 수 있습니다.
# 이 주소와 스크립트가 파일을 받는 주소는 화면에서 명령을 받은 뒤 10분 동안만 쓸 수 있습니다.
# 설치 폴더는 SWUNION_DIR 환경변수로 바꿀 수 있습니다.
# irm | iex 로 실행되면 exit 가 학생의 PowerShell 창을 닫으므로 함수로 감싸고 return 으로 끝낸다.
function Invoke-SwunionInstall {
  $PublicBaseUrl = '{{BASE_URL}}'
  $Code = '{{CODE}}'
  $CourseId = '{{COURSE_ID}}'
  if ($env:SWUNION_DIR) { $Dir = $env:SWUNION_DIR } else { $Dir = Join-Path $env:USERPROFILE "swunion-course-$CourseId" }

  function Write-FailBlock([string]$Reason) {
    Write-Output '---SWUNION-VERIFY-BEGIN---'
    Write-Output 'verify=fail'
    Write-Output "failed=install:$Reason"
    Write-Output '---SWUNION-VERIFY-END---'
  }

  Write-Output '[1/4] uv 확인'
  if (-not (Get-Command uv -ErrorAction SilentlyContinue)) {
    Write-Output 'uv가 없어 설치합니다.'
    powershell -ExecutionPolicy ByPass -c "irm https://astral.sh/uv/install.ps1 | iex"
    $env:Path = "$env:USERPROFILE\.local\bin;$env:Path"
    if (-not (Get-Command uv -ErrorAction SilentlyContinue)) {
      Write-Output 'uv 설치에 실패했습니다.'
      Write-FailBlock 'UvInstallFailed'
      return
    }
  }

  Write-Output "[2/4] 수업 파일 내려받기: $Dir"
  try {
    $ProgressPreference = 'SilentlyContinue'
    New-Item -ItemType Directory -Force -Path $Dir | Out-Null
    Set-Location -Path $Dir
    foreach ($f in 'pyproject.toml', 'uv.lock', '.python-version', 'verify.py') {
      Invoke-WebRequest -UseBasicParsing -Uri "$PublicBaseUrl/l/$Code/files/$f" -OutFile (Join-Path $Dir $f)
    }
  } catch {
    Write-Output '수업 파일을 내려받지 못했습니다.'
    Write-FailBlock 'DownloadFailed'
    return
  }

  Write-Output '[3/4] 패키지 설치 (uv sync --frozen)'
  uv sync --frozen
  if ($LASTEXITCODE -ne 0) {
    Write-Output '패키지 설치에 실패했습니다.'
    Write-FailBlock 'UvSyncFailed'
    return
  }

  Write-Output '[4/4] 설치 검증'
  # verify.py가 블록을 못 찍고 죽는 경우(예: 인터프리터 오류)에도 학생이 붙여넣을 블록이 있게 한다.
  $out = uv run --frozen python verify.py 2>&1 | ForEach-Object { "$_" }
  $out | ForEach-Object { Write-Output $_ }
  if (-not ($out -contains '---SWUNION-VERIFY-END---')) { Write-FailBlock 'Crashed' }
}
Invoke-SwunionInstall
